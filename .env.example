# -----------------------------------------------------------------------------
# Frontend (Vite). These two values are PUBLIC by design: they are shipped to
# every browser and all access is enforced by Row Level Security.
# Find them in Supabase → Project Settings → API.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# -----------------------------------------------------------------------------
# Admin provisioning script only (npm run admin:provision). Run it from a
# trusted machine. NEVER prefix these with VITE_, never deploy them to Vercel,
# never commit real values.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
