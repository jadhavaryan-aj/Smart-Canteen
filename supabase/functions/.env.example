# Secrets for the Edge Functions. Set them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; that file is git-ignored).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to Edge Functions automatically by Supabase.

# Razorpay (optional until you take payments). Until these are set, checkout
# shows "Online payments aren't set up yet" and no order can be paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live keys (rzp_live_...) are refused unless this is exactly "true".
ALLOW_LIVE_PAYMENTS=false

# Comma-separated origins allowed to call the functions from a browser.
ALLOWED_ORIGINS=http://localhost:5173
